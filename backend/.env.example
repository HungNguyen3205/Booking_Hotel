APP_NAME="GLG HOTEL & SPA"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Địa chỉ người dùng truy cập (Next.js chuyển tiếp /api sang Laravel nên cùng origin)
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# SQLite cho máy đơn/thử nghiệm. Vận hành nhiều người: MySQL 8 / MariaDB 10.6+
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=glg_hotel
# DB_USERNAME=glg
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=glg_hotel_session
SESSION_SECURE_COOKIE=false
CACHE_STORE=database

# Tài khoản chủ khách sạn tạo khi seed (mật khẩu >= 12 ký tự)
HOTEL_ADMIN_EMAIL=owner@example.test
HOTEL_ADMIN_PASSWORD=

# Dữ liệu demo + tài khoản thử theo vai trò (mật khẩu >= 10 ký tự). Tắt trên môi trường thật.
HOTEL_SEED_DEMO=true
HOTEL_DEMO_PASSWORD=

# Webhook báo có ngân hàng: chuỗi bí mật dùng ký HMAC-SHA256. Để trống = tắt webhook.
PAYMENT_WEBHOOK_SECRET=

# Email: log = chỉ ghi log (chưa gửi thật). Dùng smtp + thông tin thật để gửi.
MAIL_MAILER=log
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="GLG HOTEL & SPA"

# Proxy tin cậy (IP máy chạy Next.js). Reverse proxy trước Next.js phải ghi IP khách vào X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1
