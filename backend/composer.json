{
  "name": "danava/booking-hotel",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-pdo_sqlite": "*",
    "laravel/framework": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  }
}
