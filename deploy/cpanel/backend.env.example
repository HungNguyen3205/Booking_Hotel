# Chép thành backend/.env trên server rồi điền các chỗ <...>. KHÔNG đưa file .env lên git.
APP_NAME="GLG HOTEL & SPA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Địa chỉ website chính (nơi chạy Next.js), không phải địa chỉ api.
APP_URL=https://<ten-mien>
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_CHANNEL=daily
LOG_LEVEL=warning

# CSDL MySQL/MariaDB tạo trong cPanel > MySQL Databases (cPanel tự thêm tiền tố tài khoản, vd: cpuser_glg)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<cpuser_glg>
DB_USERNAME=<cpuser_glg>
DB_PASSWORD=<mat-khau-db>

SESSION_DRIVER=database
SESSION_COOKIE=glg_hotel_session
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Tài khoản chủ khách sạn tạo ở lần seed đầu (mật khẩu >= 12 ký tự)
HOTEL_ADMIN_EMAIL=<email-chu-khach-san>
HOTEL_ADMIN_PASSWORD=<mat-khau-manh>

# Môi trường thật: tắt dữ liệu demo
HOTEL_SEED_DEMO=false
HOTEL_DEMO_PASSWORD=

PAYMENT_WEBHOOK_SECRET=

MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=mail.<ten-mien>
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=<email>
# MAIL_PASSWORD=<mat-khau-email>
# MAIL_FROM_ADDRESS=<email>
# MAIL_FROM_NAME="GLG HOTEL & SPA"

# IP mà Next.js dùng khi gọi sang api.<ten-mien> = IP của chính server (cPanel > Server Information / "Shared IP Address").
TRUSTED_PROXIES=127.0.0.1,::1,<ip-server>
