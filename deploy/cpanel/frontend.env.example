# Chép thành frontend/.env.production.local trên server. Phải có TRƯỚC khi build (giá trị được đọc lúc build).
# Địa chỉ website chính (dùng cho SEO: canonical, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://<ten-mien>
# Địa chỉ backend Laravel (subdomain trỏ vào backend/public)
HOTEL_API_URL=https://api.<ten-mien>
